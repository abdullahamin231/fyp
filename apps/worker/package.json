{
  "name": "@unify/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UNIFY verification worker — deterministic context-packet builder, bounded verifier loop, verdict/provenance gate (TODO §3.3)",
  "scripts": {
    "prebuild": "npm run build --workspace @unify/contracts",
    "build": "tsc -p tsconfig.json",
