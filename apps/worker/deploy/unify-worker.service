# UNIFY verification worker — systemd unit (template)
#
# This file is a template: `@REPO@`, `@USER@`, `@GROUP@`, `@NODE@` and `@NPM@`
# are substituted by `deploy/install.sh`. Do not install this file directly —
# run `./deploy/install.sh` instead.
#
# The worker is a poller, not a server: it makes outbound HTTPS calls to
# Supabase and spawns the `opencode` CLI locally. It never opens a port, so it
# must NOT be exposed to the internet — the service-role key stays on this box.

[Unit]
Description=UNIFY verification worker
Documentation=file://@REPO@/apps/worker/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as your own user (not root) so the opencode CLI + model cache resolve.
User=@USER@
Group=@GROUP@

# The worker reads .env from its working directory (see src/config.ts loadDotEnv).
WorkingDirectory=@REPO@/apps/worker
EnvironmentFile=@REPO@/apps/worker/.env

# Model seam + operational values are hardcoded in src/config.ts (WORKER_SETTINGS):
# `stub` = offline/deterministic (no model needed); `opencode` = the real
# runner, `opencode run -m` per call, with UNIFY_MODEL-style models:
#   opencode/ling-3.1-flash-free   (fast, free, good JSON)
#   opencode/space-bunny-free      (zero-retention, 1M ctx, time-limited)
# There is no silent fallback between the two. Evidence enrichment
# (ANALYSIS_ENABLED) is on there too, with the repo cache under this user's
# home (writable by design — see ProtectHome above). The unit's .env carries
# the Supabase URL/service-role key and, for private repositories,
# ANALYSIS_GIT_TOKEN.

# Optional tuning (defaults shown; see src/config.ts):
# Environment=MODEL_TIMEOUT_MS=180000
# Environment=POLL_INTERVAL_MS=3000
# Environment=PACKET_TOKEN_BUDGET=8000

ExecStart=@NPM@ run dev

# Restart on crash; back off a little so a hard failure loop doesn't spin.
Restart=always
RestartSec=5

# Hardening. Deliberately light: the worker runs repository code (the analyser's
# test run) and writes its own caches, so ProtectHome stays writable.
# `ProtectSystem=full` only makes /usr, /boot, /etc read-only — home stays writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
