# UNIFY Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ── Webhook Secrets ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=replace_with_32_char_random_string
JIRA_WEBHOOK_SECRET=replace_with_32_char_random_string
FIGMA_WEBHOOK_SECRET=replace_with_32_char_random_string

# ── GitHub ─────────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./integrations/github/private_key.pem
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# For quick testing with a PAT (fine-grained, read-only):
GITHUB_PAT=

# ── Jira (Atlassian) ───────────────────────────────────────────────────────
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_DOMAIN=your-domain.atlassian.net
# For quick testing with an API token:
JIRA_API_TOKEN=
JIRA_EMAIL=

# ── Figma ──────────────────────────────────────────────────────────────────
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
# For quick testing with a Personal Access Token:
FIGMA_PAT=
FIGMA_TEAM_ID=

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://unify:unify@localhost:5432/unify_dev
# Used for pgp_sym_encrypt — keep this SECRET, minimum 32 chars
DB_ENCRYPTION_KEY=replace_with_strong_encryption_key

# ── Receiver ──────────────────────────────────────────────────────────────
PORT=4000

# ── Fixture Repo ──────────────────────────────────────────────────────────
FIXTURE_GITHUB_OWNER=
FIXTURE_GITHUB_REPO=unify-fixture
FIXTURE_JIRA_PROJECT_KEY=UNIFY
FIXTURE_FIGMA_FILE_KEY=
