{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unify/dataset/02_case_schema.json",
  "title": "UNIFY pilot case packet (annotator-facing)",
  "description": "One verification case: one atomic criterion, one change under review, pinned evidence. Labels are NOT part of the packet; they live in 05_raw_annotations/ and the adjudication log. Taxonomy frozen per Action Plan §2 (pilot-0.1).",
  "type": "object",
  "required": ["case_id", "dataset_version", "repository", "versions", "change_under_review", "intent", "design_evidence", "code_evidence", "test_evidence", "candidate_spans", "events"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
    "dataset_version": {"type": "string"},
    "repository": {
      "type": "object", "required": ["repo_id", "url", "licence"],
      "properties": {"repo_id": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "licence": {"type": "string"}}
    },
    "versions": {
      "type": "object", "required": ["base_sha", "head_sha"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_patch": {"type": ["string", "null"], "description": "Patch applied on top of head_sha to obtain the evaluated head, if any."},
        "head_patch_sha256": {"type": ["string", "null"]}
      }
    },
    "change_under_review": {"type": "object", "required": ["pr", "title"]},
    "intent": {
      "type": "object", "required": ["criterion_id", "criterion", "source", "source_quote", "criterion_version"],
      "properties": {
        "criterion": {"type": "string", "description": "Exactly one atomic, checkable criterion."},
        "source_quote": {"type": "string", "description": "Verbatim text the criterion was derived from."},
        "issue_url": {"type": ["string", "null"]},
        "issue_body_retrieved": {"type": "boolean"}
      }
    },
    "design_evidence": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["PRESENT", "NOT_APPLICABLE"]}}},
    "code_evidence": {"type": "object", "required": ["changed_hunks"]},
    "test_evidence": {"type": "object", "required": ["changed_test_hunks", "test_runs"]},
    "candidate_spans": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["span_id", "file", "symbol", "start_line", "end_line", "content_sha256"],
        "properties": {"start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}}
      }
    },
    "events": {
      "type": "array",
      "items": {"type": "object", "required": ["seq", "source", "type", "entity", "occurred_at", "delivered_order"]}
    }
  },
  "$defs": {
    "label": {
      "description": "Shape of one annotator's label for one case (05_raw_annotations).",
      "type": "object",
      "required": ["case_id", "annotator", "verdict", "freshness_state", "review_required", "relevant_span_ids", "justification"],
      "properties": {
        "verdict": {"enum": ["SUPPORTED", "CONTRADICTED", "PARTIAL", "INSUFFICIENT_EVIDENCE"]},
        "freshness_state": {"enum": ["CURRENT", "STALE", "UNKNOWN"]},
        "review_required": {"type": "boolean"},
        "reason_code": {"enum": ["", "SOURCE_STALE", "MISSING_TEST", "AMBIGUOUS_LINK", "AMBIGUOUS_CRITERION", "INVALID_CITATION", "DYNAMIC_BEHAVIOUR", "TRUNCATED_EVIDENCE", "OTHER"]},
        "relevant_span_ids": {"type": "array", "items": {"type": "string"}},
        "justification": {"type": "string", "minLength": 10}
      }
    },
    "origin": {"enum": ["REAL", "CONTROLLED_MUTATION", "SYNTHETIC"], "description": "Recorded in the constructor key only, never shown to annotators."}
  }
}
